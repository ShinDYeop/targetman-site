{
  "$schema": "node_modules/wrangler/config-schema.json",

  // 타겟맨 신동엽 · 리스 장기렌트 사이트
  // 이 파일이 배포의 전부입니다. `wrangler deploy` 가 이걸 읽습니다.
  "name": "targetman",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 정적 파일은 dist/client 에서 바로, 나머지 경로는 SSR 워커가 처리합니다.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "vars": { "HF_ENV": "prod", "APP_SLUG": "targetman" },

  // 후기 / 차량별 견적 / 견적요청 / 설정이 들어가는 데이터베이스.
  // database_id 는 D1 을 만들면 나오는 값으로 채웁니다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "targetman-db",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],

  // 업로드한 사진이 들어가는 저장소.
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "targetman-assets"
    }
  ]

  // 비밀값(ADMIN_PASSWORD / OWNER_EMAIL / RESEND_API_KEY)은 여기 두지 않습니다.
  // `wrangler secret put <이름>` 으로 넣습니다. 저장소에는 절대 올라가지 않습니다.
}
